---
// A quiet signature element: two progressions on one shared timeline —
// training load on the platform, and depth of systems/security work.
// Same discipline, two bars.
---
<div class="chart-wrap">
  <svg viewBox="0 0 640 150" preserveAspectRatio="none" role="img" aria-label="Two upward trend lines from 2020 to 2026, representing training progression and technical depth over time">
    <!-- grid -->
    <line x1="0" y1="20"  x2="640" y2="20"  class="grid" />
    <line x1="0" y1="70"  x2="640" y2="70"  class="grid" />
    <line x1="0" y1="120" x2="640" y2="120" class="grid" />

    <!-- load (amber) -->
    <polyline class="line-load"
      points="0,128 110,120 220,104 330,88 440,58 530,40 640,16" />

    <!-- systems / security depth (blue) -->
    <polyline class="line-sys"
      points="0,136 110,132 220,122 330,96 440,72 530,46 640,22" />

    <!-- now marker -->
    <line x1="640" y1="0" x2="640" y2="150" class="now-line" />
  </svg>
  <div class="legend">
    <span class="legend-item"><i class="dot dot-load"></i>total on the platform</span>
    <span class="legend-item"><i class="dot dot-sys"></i>systems worked on</span>
    <span class="legend-range">2020 → now</span>
  </div>
</div>

<style>
.chart-wrap {
  margin: 2.5rem 0;
  padding: 1.25rem 1.25rem 1rem;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--bg-2);
}
svg { width: 100%; height: 90px; display: block; overflow: visible; }
.grid { stroke: var(--border); stroke-width: 1; }
.line-load {
  fill: none;
  stroke: var(--accent-2);
  stroke-width: 1.75;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.line-sys {
  fill: none;
  stroke: var(--accent);
  stroke-width: 1.75;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.now-line {
  stroke: var(--text-dim);
  stroke-width: 1;
  stroke-dasharray: 2 3;
}
.legend {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  margin-top: 0.9rem;
  font-family: var(--font-display);
  font-size: 0.68rem;
  color: var(--text-dim);
}
.legend-item { display: flex; align-items: center; gap: 0.4rem; }
.dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
.dot-load { background: var(--accent-2); }
.dot-sys  { background: var(--accent); }
.legend-range { margin-left: auto; }
</style>
