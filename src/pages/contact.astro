---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Patrick Gauguin.">
  <div class="container page">
    <span class="eyebrow">Contact</span>
    <h1>Get in touch</h1>
    <p class="intro">Best reached by email. Also on GitHub and LinkedIn — links below once added.</p>

    <ul class="contact-list">
      <li>
        <span class="label">email</span>
        <a href="mailto:patrick@ryom.eu">patrick@ryom.eu</a>
      </li>
      <li>
        <span class="label">github</span>
        <a href="https://github.com/patrickGauguin">https://github.com/patrickGauguin</a>
      </li>
      <li>
        <span class="label">linkedin</span>
        <a href="https://www.linkedin.com/in/patrick-gauguin-a9b721395">https://www.linkedin.com/in/patrick-gauguin-a9b721395</a>
      </li>
      <li>
        <span class="label">location</span>
        <span class="value">Odense, Denmark</span>
      </li>
    </ul>
  </div>
</Layout>

<style>
h1 { font-size: 1.6rem; margin-bottom: 0.6rem; }
.intro { font-size: 0.9rem; margin-bottom: 2.25rem; }
.contact-list { list-style: none; }
.contact-list li {
  display: flex;
  gap: 1.25rem;
  align-items: baseline;
  padding: 0.9rem 0;
  border-top: 1px solid var(--border);
}
.contact-list li:last-child { border-bottom: 1px solid var(--border); }
.label {
  font-family: var(--font-display);
  font-size: 0.72rem;
  color: var(--text-dim);
  width: 80px;
  flex-shrink: 0;
}
.contact-list a, .value {
  font-size: 0.9rem;
  color: var(--text);
}
.contact-list a[data-placeholder] { color: var(--text-dim); font-style: italic; }
</style>
